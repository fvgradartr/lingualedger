# Copy to .env.local. Never commit .env.local.

# Public testnet treasury. The app also falls back to this id in source.
NEXT_PUBLIC_CONTRACT_ID=lingualedger-hq.testnet
NEAR_CONTRACT_ID=lingualedger-hq.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_NETWORK_ID=testnet

# Function-call key. Live methods: record_sale and settle only (not request_spend).
# Leave blank for a local receipt that does not move testnet NEAR.
# Safe to set on Vercel for the hosted desk. Never put the owner full-access key here.
AGENT_FC_ACCOUNT_ID=
AGENT_FC_PRIVATE_KEY=

# Sponsored guest that pays the quote on the live desk. Full-access on the guest
# account only, not on the treasury. Required together with the function-call key
# for real testnet settlement. Leak risk is limited to the guest balance.
DEMO_PAYER_ACCOUNT_ID=
DEMO_PAYER_PRIVATE_KEY=
DEMO_MAX_SETTLEMENTS_PER_HOUR=12

# Owner key for scripts/deploy-testnet.mjs and scripts/smoke-testnet.mjs.
# Prefer the near-cli credentials file under ~/.near-credentials.
OWNER_PRIVATE_KEY=

# NEAR AI Cloud. Either name works. Without a key the desk uses free public MT.
# Set a key only when the account has credits. After each completion the server
# verifies the TEE signature; a receipt is marked verified only when that check passes.
NEAR_AI_API_KEY=
NEARAI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_MAX_PER_HOUR=12

# Optional Agent Market. Unsigned webhooks are accepted only outside production.
AGENT_API_TOKEN=
AGENT_MARKET_WEBHOOK_SECRET=
AGENT_MARKET_BASE_URL=https://market.near.ai
DEMO_OPEN_WEBHOOK=

# 1Click dry quotes. No key required. Live swaps are not implemented.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
ONECLICK_RECIPIENT=wrap.near
# Public example refund addresses required by the quote schema. Not LinguaLedger wallets.
ONECLICK_REFUND_SOL=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM
ONECLICK_REFUND_EVM=0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045

# Local desk kill switch. Set to 0 to refuse the Pause button.
DEMO_OPEN_KILL_SWITCH=1

# Set to 1 to skip testnet view calls (tests do this).
LINGUALEDGER_OFFLINE=

# Price assumptions if the 1Click token list is unreachable.
NEAR_USD_PRICE=3.5
MODEL_USD_PER_MILLION=0.15
